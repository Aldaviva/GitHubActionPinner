<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-arm;osx-x64;osx-arm64</RuntimeIdentifiers>
        <Version>1.0.0</Version>
        <Authors>Ben Hutchison</Authors>
        <Copyright>© 2026 $(Authors)</Copyright>
        <AssemblyTitle>GitHub Action Pinner</AssemblyTitle>
        <Product>$(AssemblyTitle)</Product>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RollForward>major</RollForward>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <DebugType>embedded</DebugType>
        <SelfContained>false</SelfContained>
        <ApplicationIcon>thumbtack.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="thumbtack.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="fasterflect" Version="3.0.0" />
        <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="Unfucked" Version="0.0.1-beta.53" />
        <PackageReference Include="Unfucked.Caching" Version="0.0.1-beta.6" />
    </ItemGroup>

</Project>